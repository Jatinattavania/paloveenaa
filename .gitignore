# --- Tools ---------------------------------------------------------------
node_modules/

# --- Generated -------------------------------------------------------------
# The HTML/CSS/JS in website/ is rebuilt by `npm run build` (and by GitHub
# Actions on every push). Only the optimised images are committed, because
# generating them needs the original photos + `npm run images`.
website/*
!website/assets/
website/assets/*
!website/assets/images/
